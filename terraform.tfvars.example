# Copy to terraform.tfvars for the target environment.
# Replace every applicable REPLACE_... value.
# Do not put secret payloads in this file.
# Before plan/apply:
#   export TF_VAR_config_revision="$(git rev-parse --short=12 HEAD)"

# EXISTING TARGET PROJECT
project_id = "REPLACE_WITH_GCP_PROJECT_ID"
region     = "us-central1"

# AGENT ARTIFACT
agent_display_name = "REPLACE_WITH_AGENT_DISPLAY_NAME"
source_archive_path = "./artifacts/REPLACE_WITH_AGENT_ARCHIVE.tar.gz"
entrypoint_module   = "auth_reference_agent.agent"
entrypoint_object   = "app"
python_version      = "3.12"
requirements_file   = "requirements.txt"

# LIVE NON-SECRET RUNTIME CONFIG
# Terraform injects config_revision automatically.
config_parameter_id    = "REPLACE_WITH_AGENT_CONFIG_PARAMETER_ID"
config_refresh_seconds = 30
runtime_config = {
  model                      = "gemini-3.7-flash"
  instruction                = "You are a concise enterprise assistant."
  environment                = "dev"
  log_level                  = "INFO"
  agent_identity_bucket_name = "REPLACE_IF_USING_AGENT_IDENTITY_STORAGE_TOOL"
  storage_object_limit       = "10"
  bigquery_query_row_limit   = "100"
  mcp_server_url             = ""
}

# BOOTSTRAP ONLY. Changing these values can create a new Agent Runtime revision.
bootstrap_env = {
  BOOTSTRAP_MODEL                    = "gemini-3.7-flash"
  GEMINI_MODEL_LOCATION              = "global"
  GEMINI_ENTERPRISE_AUTHORIZATION_ID = "REPLACE_IF_USING_AUTH_REFERENCE_AGENT"
}

# SECRETS
# Keep payloads out of terraform.tfvars. Populate managed_secrets only when this
# stack owns the Secret Manager object. Supply matching TF_VAR_secret_values at apply.
managed_secrets = {}

# DEVELOPER DEPLOYMENT ACCESS
# Prefer a Google Group. Leave empty when developer deployment helpers are not used.
developer_deployer_members = [
  "group:REPLACE_WITH_DEV_GROUP@example.com",
]
developer_parameter_access    = true
developer_staging_bucket_name = "REPLACE_WITH_EXISTING_DEV_STAGING_BUCKET_NAME"

# Required when developer_deployer_members is non-empty.
# Organization project:
developer_agent_identity_organization_id = "REPLACE_WITH_ORGANIZATION_ID"
developer_agent_identity_orgless         = false
# Orgless project instead:
# developer_agent_identity_organization_id = null
# developer_agent_identity_orgless         = true

# CALLER ACCESS
invoker_members = [
  "group:REPLACE_WITH_AGENT_USERS@example.com",
]

# TERRAFORM-MANAGED AGENT IDENTITY ACCESS
agent_project_roles = [
  "roles/aiplatform.expressUser",
  "roles/serviceusage.serviceUsageConsumer",
  "roles/parametermanager.parameterAccessor",
  "roles/storage.objectViewer",
]

# OBSERVABILITY
# log_bucket_id may be omitted/null. Terraform generates a deterministic per-agent
# bucket ID so multiple agent stacks in the same project do not collide.
log_bucket_id        = null
log_retention_days   = 90
