# LOCAL WORKSTATION EXECUTION
# Run: gcloud auth application-default login
# Copy to dev/.env.local and replace required placeholders.
# CONFIG_PARAMETER is intentionally absent; local execution reads these values directly.

# REQUIRED
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_DEV_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1
ENVIRONMENT=local
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MODEL_LOCATION=global
AGENT_INSTRUCTION=You are a concise enterprise assistant.
LOG_LEVEL=DEBUG

# OPTIONAL / AGENT-SPECIFIC
CONFIG_REVISION=local
AGENT_IDENTITY_BUCKET_NAME=REPLACE_IF_USING_AUTH_REFERENCE_AGENT_STORAGE_TOOL
STORAGE_OBJECT_LIMIT=10
BIGQUERY_QUERY_ROW_LIMIT=100
MAX_ATTEMPTS=3
MAX_MODEL_CALLS_PER_REQUEST=100
CONTEXT_COMPACTION_THRESHOLD_TOKENS=100000

# Which tool calls reach the logs: off, names, argument_keys or full.
# Remote runtimes read this from Parameter Manager instead. "full" records
# arguments and results, which for a delegated tool is the signed-in user's
# own query text, so keep it for deliberate debugging.
TOOL_CALL_LOGGING=off

# MCP endpoint, resolved when the agent is constructed. Each MCP agent falls
# back to its own endpoint, so leave this empty unless pointing a local run at
# a different server. One variable serves whichever agent you run.
MCP_SERVER_URL=

# Remote runtimes get this from the agent's AgentSpec.runtime_env. Set it here
# only to reproduce that behaviour in a local run: it sends MCP input schemas
# only, omitting each tool's outputSchema.
ADK_DISABLE_JSON_SCHEMA_FOR_FUNC_DECL=

# Prefix holding recipe cards, as <prefix>/<dish>/<run>/. Remote runtimes get
# this from AgentSpec.runtime_env; it defaults to "recipe-cards" when unset.
RECIPE_CARD_PREFIX=

# Required to construct either delegated agent; end-to-end auth needs Gemini Enterprise.
GEMINI_ENTERPRISE_AUTHORIZATION_ID=REPLACE_IF_RUNNING_A_DELEGATED_AGENT
