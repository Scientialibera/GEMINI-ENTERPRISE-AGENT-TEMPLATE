# REMOTE DEVELOPER DEPLOYMENT ONLY
#
# 1. Run:
#      gcloud auth login
#      gcloud auth application-default login
# 2. Copy to dev/.env.dev.
# 3. Replace every REQUIRED placeholder.
# 4. Run `uv run --group dev python dev/config/bootstrap_dev.py`.
#
# Review the creation controls before running. Bootstrap never grants IAM.
# The optional per-agent IAM helper below grants only explicitly configured
# roles to the exact Agent Identity after that runtime exists.

# REQUIRED DEPLOYMENT COORDINATES
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_DEV_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1
DEV_STAGING_BUCKET=gs://REPLACE_WITH_DEV_STAGING_BUCKET
ENVIRONMENT=dev

# OPTIONAL DEVELOPER-SANDBOX CREATION
DEV_CREATE_PROJECT_IF_MISSING=false
DEV_BILLING_ACCOUNT_ID=REPLACE_IF_CREATING_PROJECT
DEV_PROJECT_FOLDER_ID=
DEV_PROJECT_ORGANIZATION_ID=
DEV_ENABLE_REQUIRED_APIS=true
DEV_CREATE_STAGING_BUCKET_IF_MISSING=true
DEV_STAGING_BUCKET_LOCATION=

# OPTIONAL BIGQUERY TEST FIXTURE
# Disable when using an existing dataset for tests.
DEV_PREPARE_BIGQUERY_FIXTURE=true
DEV_CREATE_BIGQUERY_FIXTURE_IF_MISSING=true
DEV_BIGQUERY_DATASET_ID=gemini_agent_template_dev
DEV_BIGQUERY_TABLE_ID=sample_orders
# Defaults to GOOGLE_CLOUD_LOCATION when empty.
DEV_BIGQUERY_LOCATION=

# RUNTIME CONFIGURATION
# Defaults to <package-name>-config. Set only for a one-off override.
CONFIG_PARAMETER=
CONFIG_PARAMETER_LOCATION=global
CONFIG_REFRESH_SECONDS=30

# BOOTSTRAP ONLY
BOOTSTRAP_MODEL=gemini-3.7-flash
GEMINI_MODEL_LOCATION=global

# DELEGATED AUTHORIZATION
# Defaults to <package-name>-authz. Set only for a one-off override.
# Declare delegated service scopes in AgentSpec.delegated_oauth_scopes.
GEMINI_ENTERPRISE_AUTHORIZATION_ID=

# bigquery_mcp_agent endpoint; changing it requires a runtime update.
MCP_SERVER_URL=https://bigquery.googleapis.com/mcp

# PER-AGENT AGENT IDENTITY IAM
# Every remote deployment already uses AGENT_IDENTITY. These settings only add
# grants to the exact identity created for one agent.
#
# Names are derived from the agent package:
#   <AGENT>_AGENT_IDENTITY_ID
#   <AGENT>_AGENT_IDENTITY_PROJECT_ROLES
#   <AGENT>_AGENT_IDENTITY_STORAGE_BUCKET_ROLES
#
# *_AGENT_IDENTITY_ID is optional and acts only as an assertion. Normally leave
# it empty because the script derives the principal from the deployed runtime.
#
# Project roles are comma-separated:
# AUTH_REFERENCE_AGENT_AGENT_IDENTITY_PROJECT_ROLES=roles/logging.logWriter
#
# Bucket bindings are semicolon-separated bucket=role|role entries and are the
# preferred way to grant Cloud Storage data access:
# AUTH_REFERENCE_AGENT_AGENT_IDENTITY_STORAGE_BUCKET_ROLES=gs://REPLACE_WITH_BUCKET=roles/storage.objectViewer
#
# The caller running dev/iam/apply_agent_identity_iam.py must already have
# permission to change IAM on the target project or bucket. The helper rejects
# roles/owner and roles/editor and never grants IAM to the caller itself.

# GEMINI ENTERPRISE REGISTRATION (register_agent.py)
# Use the app's engine ID.
GEMINI_ENTERPRISE_APP_ID=REPLACE_IF_REGISTERING_AGENTS

# PER-AGENT OAUTH CLIENTS
# Create a Web application client for each delegated agent with both callbacks:
#   https://vertexaisearch.cloud.google.com/static/oauth/oauth.html
#   https://vertexaisearch.cloud.google.com/oauth-redirect
#
# Map agent names to IDs; <AGENT>_OAUTH_CLIENT_ID overrides its map entry.
# Example: auth_reference_agent=<id>,bigquery_mcp_agent=<other-id>
OAUTH_CLIENTS=

# Supply initial secrets per agent, then remove after import into Secret Manager:
#   AUTH_REFERENCE_AGENT_OAUTH_CLIENT_SECRET=REPLACE_ON_FIRST_RUN_ONLY
#   BIGQUERY_MCP_AGENT_OAUTH_CLIENT_SECRET=REPLACE_ON_FIRST_RUN_ONLY

# Optional secret fallback when no per-agent secret is supplied. Never commit it.
GEMINI_ENTERPRISE_OAUTH_CLIENT_SECRET=
