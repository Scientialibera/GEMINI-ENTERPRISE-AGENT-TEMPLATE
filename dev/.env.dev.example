# REMOTE DEVELOPER DEPLOYMENT ONLY
#
# 1. Run:
#      gcloud auth login
#      gcloud auth application-default login
# 2. Copy to dev/.env.dev.
# 3. Replace every REQUIRED placeholder.
# 4. Run `uv run --group dev python dev/bootstrap_dev.py`.
#
# Existing developer-sandbox resources are reused. The helper may create the
# project/APIs/staging bucket and optional BigQuery test fixture only under the
# explicit controls below. It never creates IAM or shared Parameter Manager
# desired state.

# REQUIRED DEPLOYMENT COORDINATES
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_DEV_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1
DEV_STAGING_BUCKET=gs://REPLACE_WITH_DEV_STAGING_BUCKET
ENVIRONMENT=dev

# OPTIONAL DEVELOPER-SANDBOX CREATION
DEV_CREATE_PROJECT_IF_MISSING=false
DEV_BILLING_ACCOUNT_ID=REPLACE_IF_CREATING_PROJECT
DEV_PROJECT_FOLDER_ID=
DEV_PROJECT_ORGANIZATION_ID=
DEV_ENABLE_REQUIRED_APIS=true
DEV_CREATE_STAGING_BUCKET_IF_MISSING=true
DEV_STAGING_BUCKET_LOCATION=

# OPTIONAL BIGQUERY TEST FIXTURE
# Enabled by default so a fresh developer sandbox has a real dataset/table for
# end-to-end delegated BigQuery testing. If you already have suitable BigQuery
# data that your Gemini Enterprise test user can query, set this to false.
DEV_PREPARE_BIGQUERY_FIXTURE=true
DEV_CREATE_BIGQUERY_FIXTURE_IF_MISSING=true
DEV_BIGQUERY_DATASET_ID=gemini_agent_template_dev
DEV_BIGQUERY_TABLE_ID=sample_orders
# Defaults to GOOGLE_CLOUD_LOCATION when empty.
DEV_BIGQUERY_LOCATION=

# REQUIRED AFTER THE TERRAFORM DEV STACK EXISTS
# Use the exact Terraform output `runtime_config_parameter`.
CONFIG_PARAMETER=REPLACE_WITH_TERRAFORM_RUNTIME_CONFIG_PARAMETER_OUTPUT
CONFIG_PARAMETER_LOCATION=global
CONFIG_REFRESH_SECONDS=30

# BOOTSTRAP ONLY
BOOTSTRAP_MODEL=gemini-3.7-flash
GEMINI_MODEL_LOCATION=global

# REQUIRED ONLY FOR auth_reference_agent
GEMINI_ENTERPRISE_AUTHORIZATION_ID=REPLACE_IF_RUNNING_AUTH_REFERENCE_AGENT

# GEMINI ENTERPRISE REGISTRATION (register_agent.py)
# The app/engine id, not the web app client id shown in the console URL.
# List available ids with:
#   gcloud alpha discovery-engine engines list --location=global
GEMINI_ENTERPRISE_APP_ID=REPLACE_IF_REGISTERING_AGENTS

# Required only when register_agent.py must CREATE a missing authorization.
# Supply from an approved secret source for that run; never commit the secret.
GEMINI_ENTERPRISE_OAUTH_CLIENT_ID=
GEMINI_ENTERPRISE_OAUTH_CLIENT_SECRET=
